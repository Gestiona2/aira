---
/**
 * Aira Studio Pilates — página informativa luxury.
 * REGLA: sin texto escrito aquí; todo sale de src/datos/inicio.json y sitio.json.
 */
import Layout from "../layouts/Layout.astro";
import datos from "../datos/inicio.json";
import sitio from "../datos/sitio.json";

const { portada, manifiesto, servicios, estudio, espacios, pasos, faq, contacto, meta } = datos;
const wa = (msg: string) => `https://wa.me/${sitio.whatsapp}?text=${encodeURIComponent(msg)}`;
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion} activa="inicio">
  {/* ============ HERO ============ */}
  <header class="hero">
    <div class="hero-bg">
      <img src={portada.imagen} alt={portada.imagenAlt} loading="eager" fetchpriority="high" />
    </div>
    <aside class="hero-sello rv">
      <strong>{portada.selloTitulo}</strong>
      <p>{portada.selloTexto}</p>
    </aside>
    <span class="hero-scroll" aria-hidden="true"></span>
    <div class="container hero-inner">
      <span class="hero-etiqueta rv">{portada.etiqueta}</span>
      <h1 class="rv">
        {portada.tituloLinea1} <em>{portada.tituloCursiva}</em><br />
        {portada.tituloLinea2}
      </h1>
      <p class="hero-sub rv">{portada.texto}</p>
      <div class="hero-ctas rv">
        <a class="btn-pill btn-ivory" href={wa(contacto.whatsappMsg)} target="_blank" rel="noopener">
          Agenda tu primera clase
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
        </a>
        <a class="btn-pill btn-line-ivory" href="#experiencias">Conocer experiencias</a>
      </div>
      <div class="hero-foot rv" data-stagger>
        {portada.stats.map((s) => (
          <div class="hero-stat">
            <strong>{s.valor}</strong>
            <span>{s.texto}</span>
          </div>
        ))}
      </div>
    </div>
  </header>

  {/* ============ MARQUEE ============ */}
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {Array.from({ length: 2 }).map(() => (
        <>
          <span><i>✦</i>Reformer</span><span><i>✦</i>Breath</span><span><i>✦</i>Alignment</span><span><i>✦</i>Presence</span><span><i>✦</i>One breath at a time</span>
        </>
      ))}
    </div>
  </div>

  {/* ============ MANIFIESTO ============ */}
  <section class="pad manifiesto">
    <div class="container">
      <span class="kicker center rv">{manifiesto.etiqueta}</span>
      <h2 class="rv">{manifiesto.titular}</h2>
      <p class="manifiesto-firma rv">{manifiesto.firma}</p>
    </div>
  </section>

  {/* ============ EXPERIENCIAS ============ */}
  <section class="pad" id="experiencias" style="padding-top:0">
    <div class="container">
      <div class="sec-head">
        <div>
          <span class="kicker rv">{servicios.etiqueta}</span>
          <h2 class="rv">{servicios.titulo}</h2>
        </div>
        <p class="rv">{servicios.texto}</p>
      </div>
      <div class="exp-grid" data-stagger>
        {servicios.items.map((s) => (
          <article class="exp-card rv">
            <div class="exp-media">
              <img src={s.imagen} alt={s.imagenAlt} loading="lazy" />
              <span class="exp-num">{s.numero}</span>
            </div>
            <div class="exp-body">
              <h3>{s.titulo}</h3>
              <p>{s.texto}</p>
              <ul class="exp-list">
                {s.incluye.map((f) => <li>{f}</li>)}
              </ul>
              <a class="exp-wa" href={wa(s.whatsappMsg)} target="_blank" rel="noopener">
                Consultar por WhatsApp
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ============ ESTUDIO ============ */}
  <section class="estudio pad" id="estudio">
    <div class="container estudio-grid">
      <div class="estudio-media rv">
        <img src={estudio.imagen} alt={estudio.imagenAlt} loading="lazy" />
        <div class="estudio-badge">
          <strong>Aira House</strong>
          <span>Luz cálida · materiales nobles</span>
        </div>
      </div>
      <div>
        <span class="kicker rv">{estudio.etiqueta}</span>
        <h2 class="rv">{estudio.titulo}</h2>
        <p class="estudio-lead rv">{estudio.texto}</p>
        <div class="ritual-list" data-stagger>
          {estudio.rituales.map((r, i) => (
            <div class="ritual rv">
              <b>0{i + 1}</b>
              <div>
                <h3>{r.titulo}</h3>
                <p>{r.texto}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ============ ESPACIOS ============ */}
  <section class="pad" id="espacios">
    <div class="container">
      <div class="sec-head">
        <div>
          <span class="kicker rv">{espacios.etiqueta}</span>
          <h2 class="rv">{espacios.titulo}</h2>
        </div>
        <p class="rv">{espacios.texto}</p>
      </div>
      <div class="gal-grid" data-stagger>
        {espacios.items.map((g) => (
          <figure class="gal-item rv">
            <img src={g.imagen} alt={g.alt} loading="lazy" />
            <figcaption class="gal-cap">
              <strong>{g.titulo}</strong>
              <span class="gal-medida">{g.medida}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* ============ PASOS ============ */}
  <section class="pad" id="empezar" style="padding-top:0">
    <div class="container">
      <span class="kicker rv">{pasos.etiqueta}</span>
      <h2 class="rv" style="font-size:clamp(2.2rem,4.6vw,3.8rem);margin-bottom:26px">{pasos.titulo}</h2>
      <div class="pasos-grid" data-stagger>
        {pasos.items.map((p) => (
          <div class="paso rv">
            <b>{p.numero}</b>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ============ FAQ ============ */}
  <section class="pad" id="faq" style="padding-top:0">
    <div class="container">
      <div style="text-align:center;margin-bottom:44px">
        <span class="kicker center rv">{faq.etiqueta}</span>
        <h2 class="rv" style="font-size:clamp(2.2rem,4.6vw,3.8rem)">{faq.titulo}</h2>
      </div>
      <div class="faq-wrap" data-stagger>
        {faq.items.map((f) => (
          <details class="faq-item rv">
            <summary>{f.pregunta}<span class="faq-plus">+</span></summary>
            <p>{f.respuesta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ============ CTA FINAL ============ */}
  <section id="contacto">
    <div class="cta-panel">
      <img class="cta-bg" src="/img/estudio-luz.jpg" alt="Interior del estudio Aira" loading="lazy" />
      <div class="cta-inner">
        <span class="kicker center rv" style="color:var(--gold)">{contacto.etiqueta}</span>
        <h2 class="rv">{contacto.titulo}</h2>
        <p class="rv">{contacto.texto}</p>
        <a class="btn-pill btn-wa rv" href={wa(contacto.whatsappMsg)} target="_blank" rel="noopener">
          Escribir por WhatsApp
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
        </a>
        <p class="cta-nota rv">{contacto.nota}</p>
      </div>
    </div>
  </section>
</Layout>
