---
/**
 * RAMA EXPERIMENTO exp/inspiracion-spa — Aira en clave spa-template clásico.
 * REGLA: sin texto escrito aquí; todo sale de src/datos/.
 * Sin precios, duraciones, horarios ni testimonios: nada inventado.
 */
import Layout from "../layouts/Layout.astro";
import datos from "../datos/inicio.json";
import sitio from "../datos/sitio.json";

const { portada, manifiesto, servicios, rituales, reserva, cita, estudio, espacios, pasos, faq, contacto, meta } = datos;
const wa = (msg: string) => `https://wa.me/${sitio.whatsapp}?text=${encodeURIComponent(msg)}`;
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion} activa="inicio" solido={true}>
  {/* ============ HERO DIVIDIDO (clave spa) ============ */}
  <header class="hero-spa">
    <div class="container hero-spa-grid">
      <div>
        <p class="script-kicker rv">Bienvenida a Aira</p>
        <h1 class="rv">
          {portada.tituloLinea1} <em>{portada.tituloCursiva}</em><br />
          {portada.tituloLinea2}
        </h1>
        <p class="hero-spa-sub rv">{portada.texto}</p>
        <div class="hero-ctas rv">
          <a class="btn-pill btn-espresso" href={wa(contacto.whatsappMsg)} target="_blank" rel="noopener">
            Agenda tu primera clase
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
          <a class="btn-pill btn-line" href="#rituales">Ver rituales</a>
        </div>
        <dl class="hero-spa-stats rv" data-stagger>
          {portada.stats.map((s) => (
            <div>
              <dt>{s.valor}</dt>
              <dd>{s.texto}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="hero-spa-media rv">
        <div class="arco">
          <img src={portada.imagen} alt={portada.imagenAlt} loading="eager" fetchpriority="high" />
        </div>
        <div class="hero-spa-sello">
          <strong>{portada.selloTitulo}</strong>
          <p>{portada.selloTexto}</p>
        </div>
      </div>
    </div>
  </header>

  <div class="ornamento" aria-hidden="true"><span></span><i>✦</i><span></span></div>

  {/* ============ MANIFIESTO ============ */}
  <section class="pad manifiesto">
    <div class="container">
      <p class="script-kicker center rv">{manifiesto.etiqueta}</p>
      <h2 class="rv">{manifiesto.titular}</h2>
      <p class="manifiesto-texto rv">{manifiesto.texto}</p>
      <p class="manifiesto-firma rv">{manifiesto.firma}</p>
    </div>
  </section>

  {/* ============ EXPERIENCIAS (tarjetas centradas clave spa) ============ */}
  <section class="pad banda" id="experiencias">
    <div class="container">
      <div class="sec-centro">
        <p class="script-kicker center rv">{servicios.etiqueta}</p>
        <h2 class="rv">{servicios.titulo}</h2>
        <p class="sec-sub rv">{servicios.texto}</p>
      </div>
      <div class="exp-spa-grid" data-stagger>
        {servicios.items.map((s) => (
          <article class="exp-spa-card rv">
            <div class="exp-spa-media">
              <img src={s.imagen} alt={s.imagenAlt} loading="lazy" />
            </div>
            <h3>{s.titulo}</h3>
            <p>{s.texto}</p>
            <ul class="exp-spa-list">
              {s.incluye.map((f) => <li>{f}</li>)}
            </ul>
            <a class="leer-mas" href={wa(s.whatsappMsg)} target="_blank" rel="noopener">
              Consultar <span>›</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ============ MENÚ DE RITUALES (patrón spa, sin precios) ============ */}
  <section class="pad" id="rituales">
    <div class="container ritual-grid">
      <div>
        <p class="script-kicker rv">{rituales.etiqueta}</p>
        <h2 class="rv">{rituales.titulo}</h2>
        <p class="sec-sub rv" style="margin:18px 0 0">{rituales.texto}</p>
        <a class="btn-pill btn-espresso rv" style="margin-top:30px" href={wa(contacto.whatsappMsg)} target="_blank" rel="noopener">
          Preguntar por WhatsApp
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
        </a>
      </div>
      <ul class="menu-ritual" data-stagger>
        {rituales.items.map((r) => (
          <li class="rv">
            <div class="menu-ritual-top">
              <strong>{r.nombre}</strong>
              <span class="menu-sello">{r.sello}</span>
            </div>
            <p>{r.descripcion}</p>
            <a class="leer-mas" href={wa(r.whatsappMsg)} target="_blank" rel="noopener">Reservar <span>›</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ============ CITA DE MARCA (verbatim manual) ============ */}
  <section class="cita-banda">
    <div class="container">
      <p class="script-kicker center rv" style="color:var(--ivory)">Manifiesto</p>
      <blockquote class="rv">“{cita.texto}”</blockquote>
      <p class="cita-firma rv">{cita.firma}</p>
    </div>
  </section>

  {/* ============ ESTUDIO ============ */}
  <section class="estudio pad" id="estudio">
    <div class="container estudio-grid">
      <div class="estudio-media rv">
        <img src={estudio.imagen} alt={estudio.imagenAlt} loading="lazy" />
        <div class="estudio-badge">
          <strong>Aira House</strong>
          <span>Luz cálida · materiales nobles</span>
        </div>
      </div>
      <div>
        <p class="script-kicker rv" style="color:var(--ivory)">{estudio.etiqueta}</p>
        <h2 class="rv">{estudio.titulo}</h2>
        <p class="estudio-lead rv">{estudio.texto}</p>
        <div class="ritual-list" data-stagger>
          {estudio.rituales.map((r, i) => (
            <div class="ritual rv">
              <b>0{i + 1}</b>
              <div>
                <h3>{r.titulo}</h3>
                <p>{r.texto}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ============ RESERVA (formulario → WhatsApp) ============ */}
  <section class="pad banda" id="reserva">
    <div class="container reserva-grid">
      <div>
        <p class="script-kicker rv">{reserva.etiqueta}</p>
        <h2 class="rv">{reserva.titulo}</h2>
        <p class="sec-sub rv" style="margin:18px 0 30px">{reserva.texto}</p>
        <div class="pasos-mini" data-stagger>
          {pasos.items.map((p) => (
            <div class="rv"><b>{p.numero}</b><div><strong>{p.titulo}</strong><p>{p.texto}</p></div></div>
          ))}
        </div>
      </div>
      <form class="form-card rv" id="formReserva">
        <label>{reserva.nombreLabel}
          <input type="text" id="fNombre" placeholder={reserva.nombrePh} autocomplete="name" required />
        </label>
        <label>{reserva.expLabel}
          <select id="fExp">
            {servicios.items.map((s) => <option value={s.titulo}>{s.titulo}</option>)}
          </select>
        </label>
        <label>{reserva.msgLabel}
          <textarea id="fMsg" rows="3" placeholder={reserva.msgPh}></textarea>
        </label>
        <button class="btn-pill btn-wa" type="submit">
          {reserva.boton}
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
        </button>
        <p class="form-nota">{reserva.nota}</p>
      </form>
    </div>
  </section>

  {/* ============ ESPACIOS ============ */}
  <section class="pad" id="espacios">
    <div class="container">
      <div class="sec-centro">
        <p class="script-kicker center rv">{espacios.etiqueta}</p>
        <h2 class="rv">{espacios.titulo}</h2>
        <p class="sec-sub rv">{espacios.texto}</p>
      </div>
      <div class="gal-grid" data-stagger>
        {espacios.items.map((g) => (
          <figure class="gal-item rv">
            <img src={g.imagen} alt={g.alt} loading="lazy" />
            <figcaption class="gal-cap">
              <strong>{g.titulo}</strong>
              <span class="gal-medida">{g.medida}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* ============ FAQ ============ */}
  <section class="pad" id="faq" style="padding-top:0">
    <div class="container">
      <div class="sec-centro" style="margin-bottom:44px">
        <p class="script-kicker center rv">{faq.etiqueta}</p>
        <h2 class="rv" style="font-size:clamp(2.2rem,4.6vw,3.8rem)">{faq.titulo}</h2>
      </div>
      <div class="faq-wrap" data-stagger>
        {faq.items.map((f) => (
          <details class="faq-item rv">
            <summary>{f.pregunta}<span class="faq-plus">+</span></summary>
            <p>{f.respuesta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ============ CTA FINAL ============ */}
  <section id="contacto">
    <div class="cta-panel">
      <img class="cta-bg" src="/img/estudio-luz.jpg" alt="Interior del estudio Aira" loading="lazy" />
      <div class="cta-inner">
        <p class="script-kicker center rv" style="color:var(--ivory)">{contacto.etiqueta}</p>
        <h2 class="rv">{contacto.titulo}</h2>
        <p class="rv">{contacto.texto}</p>
        <a class="btn-pill btn-wa rv" href={wa(contacto.whatsappMsg)} target="_blank" rel="noopener">
          Escribir por WhatsApp
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
        </a>
        <p class="cta-nota rv">{contacto.nota}</p>
      </div>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ waBase: `https://wa.me/${sitio.whatsapp}` }}>
  (function () {
    var form = document.getElementById("formReserva");
    if (!form) return;
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var nombre = (document.getElementById("fNombre").value || "").trim();
      var exp = document.getElementById("fExp").value;
      var msg = (document.getElementById("fMsg").value || "").trim();
      if (!nombre) { document.getElementById("fNombre").focus(); return; }
      var texto = "Hola Aira, soy " + nombre + " y quiero reservar: " + exp + (msg ? ". " + msg : "");
      window.open(waBase + "?text=" + encodeURIComponent(texto), "_blank", "noopener");
    });
  })();
</script>
