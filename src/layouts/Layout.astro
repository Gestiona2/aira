---
/**
 * Layout Aira — estructura global luxury.
 * Sin dependencias externas: sin Lucide/GSAP remotos, iconos SVG inline.
 * El contenido vive en src/datos/.
 */
import "../styles/global.css";
import sitio from "../datos/sitio.json";

interface Props {
  titulo: string;
  descripcion?: string;
  activa?: string;
}
const { titulo, descripcion = sitio.descripcion, activa = "" } = Astro.props;
const waBase = `https://wa.me/${sitio.whatsapp}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/brand/favicon.png" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#1E1B17" />
    <noscript><style>.rv { opacity: 1 !important; transform: none !important; }</style></noscript>
  </head>

  <body>
    <div class="anuncio">
      <span class="anuncio-punto"></span>
      {sitio.anuncio}
      <a href={sitio.ctaPrincipal.href} target="_blank" rel="noopener">Agendar →</a>
    </div>

    <header class="nav" id="nav">
      <div class="container nav-inner">
        <a href="/" class="nav-logo" aria-label="Aira inicio">
          <img src="/brand/logo.png" alt="aira — the pilates house" />
        </a>
        <nav class="nav-links" id="navLinks" aria-label="Navegación principal">
          {sitio.menu.map((item) => (
            <a href={item.href} class={activa === item.id ? "activo" : ""}>{item.texto}</a>
          ))}
        </nav>
        <div class="nav-actions">
          <a href={sitio.ctaPrincipal.href} class="btn-pill btn-espresso" target="_blank" rel="noopener">
            {sitio.ctaPrincipal.texto}
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
          <button id="botonMenu" class="nav-burger" aria-label="Abrir menú" aria-expanded="false">
            <span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pie">
      <div class="container">
        <div class="pie-top">
          <img class="pie-logo" src="/brand/logo-claro.png" alt="aira" loading="lazy" />
          <p class="pie-tag">The Pilates House · One breath at a time.</p>
          <a class="btn-pill btn-ivory" href={sitio.ctaPrincipal.href} target="_blank" rel="noopener">
            Agenda por WhatsApp
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
        </div>
        <div class="pie-bottom">
          <p>© {new Date().getFullYear()} {sitio.razonSocial}. Todos los derechos reservados.</p>
          <p class="pie-lugar">{sitio.direccion} · {sitio.horario}</p>
        </div>
      </div>
    </footer>

    <a href={waBase} class="wa-flotante" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 0 1 12 4Zm-3.2 3.5c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1.1 2.7c.1.2 1.9 3.1 4.8 4.1 2.4.9 2.9.7 3.4.7.5-.1 1.6-.7 1.9-1.3.2-.6.2-1.2.2-1.3-.1-.1-.3-.2-.6-.3l-2-1c-.3-.1-.5-.2-.7.1l-.9 1.1c-.2.2-.3.2-.6.1a7.6 7.6 0 0 1-2.2-1.4 8.2 8.2 0 0 1-1.5-1.9c-.2-.3 0-.4.1-.6l.5-.6c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5L9.4 7.3c-.2-.3-.4-.3-.6-.3Z"/></svg>
      <span>WhatsApp</span>
    </a>

    <script is:inline>
      (function () {
        var nav = document.getElementById("nav");
        var btn = document.getElementById("botonMenu");
        var links = document.getElementById("navLinks");
        var onScroll = function () {
          nav.classList.toggle("scrolled", window.scrollY > 24);
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
        if (btn && links) {
          btn.addEventListener("click", function () {
            var open = links.classList.toggle("open");
            btn.setAttribute("aria-expanded", String(open));
            btn.classList.toggle("x", open);
          });
          links.addEventListener("click", function (e) {
            if (e.target.tagName === "A") {
              links.classList.remove("open");
              btn.classList.remove("x");
              btn.setAttribute("aria-expanded", "false");
            }
          });
        }
        // Apariciones: robustas, sin librerías. Si no hay observer, se muestra todo.
        var els = Array.prototype.slice.call(document.querySelectorAll(".rv"));
        document.querySelectorAll("[data-stagger]").forEach(function (g) {
          Array.prototype.forEach.call(g.children, function (child, i) {
            child.style.setProperty("--d", (i * 90) + "ms");
          });
        });
        if (!("IntersectionObserver" in window) || !els.length) {
          els.forEach(function (el) { el.classList.add("in"); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              en.target.classList.add("in");
              io.unobserve(en.target);
            }
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -6% 0px" });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
